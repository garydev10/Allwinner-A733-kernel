#!/bin/sh
PREREQ=""
prereqs() {
    echo "$PREREQ"
}
case $1 in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

copy_exec /sbin/blkid /sbin 2>/dev/null || true
copy_exec /usr/sbin/blkid /sbin 2>/dev/null || true
copy_exec /bin/lsblk /bin 2>/dev/null || true
copy_exec /usr/bin/lsblk /bin 2>/dev/null || true
copy_exec /sbin/partprobe /sbin 2>/dev/null || true
copy_exec /usr/sbin/partprobe /sbin 2>/dev/null || true
