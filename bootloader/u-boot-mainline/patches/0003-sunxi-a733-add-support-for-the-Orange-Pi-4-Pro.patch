From: Orange Pi Developer <dev@orangepi.local>
Date: Tue, 10 Nov 2026 19:30:00 +0000
Subject: [PATCH 3/3] sunxi: a733: add support for the Orange Pi 4 Pro

Add orangepi-4-pro DTS and orangepi-4-pro_defconfig based on the A733
baseline. The Orange Pi 4 Pro routes USB host power through PL2 and
UART0 on PB9/PB10.
---
 arch/arm/dts/sun60i-a733-orangepi-4-pro.dts | 204 +++++++++++++++++++++++++
 configs/orangepi-4-pro_defconfig            |  22 +++
 2 files changed, 226 insertions(+)
 create mode 100644 arch/arm/dts/sun60i-a733-orangepi-4-pro.dts
 create mode 100644 configs/orangepi-4-pro_defconfig

diff --git a/arch/arm/dts/sun60i-a733-orangepi-4-pro.dts b/arch/arm/dts/sun60i-a733-orangepi-4-pro.dts
new file mode 100644
index 00000000..047b9ea0
--- /dev/null
+++ b/arch/arm/dts/sun60i-a733-orangepi-4-pro.dts
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+// Copyright (C) 2025 Arm Ltd.
+
+/dts-v1/;
+
+#include sun60i-a733.dtsi
+
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = Orange Pi 4 Pro;
+	compatible = xunlong,orangepi-4-pro, allwinner,sun60i-a733;
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = serial0:115200n8;
+	};
+
+	reg_vcc5v: vcc5v {
+		/* board wide 5V supply from the USB-C connector */
+		compatible = regulator-fixed;
+		regulator-name = vcc-5v;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+
+	reg_usb_vbus: vbus {
+		compatible = regulator-fixed;
+		regulator-name = usb-vbus;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_vcc5v>;
+		gpio = <&r_pio 0 2 GPIO_ACTIVE_HIGH>;	/* PL2 */
+		enable-active-high;
+	};
+};
+
+&uart0 {
+	pinctrl-names = default;
+	pinctrl-0 = <&uart0_pb_pins>;
+	status = okay;
+};
+
+&mmc0 {
+	bus-width = <4>;
+	status = okay;
+};
+
+&mmc2 {
+	bus-width = <8>;
+	cap-mmc-hw-reset;
+	mmc-ddr-1_8v;
+	mmc-hs200-1_8v;
+	non-removable;
+	vmmc-supply = <&reg_cldo5>;
+	vqmmc-supply = <&reg_swout2>;
+	status = okay;
+};
+
+&usb_otg {
+	dr_mode = peripheral;
+	status = okay;
+};
+
+&usbphy {
+	usb0_vbus-supply = <&reg_vcc5v>;
+	usb1_vbus-supply = <&reg_usb_vbus>;
+	status = okay;
+};
+
+&ehci0 {
+	status = okay;
+};
+
+&ohci0 {
+	status = okay;
+};
+
+&ehci1 {
+	status = okay;
+};
+
+&ohci1 {
+	status = okay;
+};
+
+&r_i2c0 {
+	status = okay;
+
+	axp318w: pmic@36 {
+		compatible = x-powers,axp318w;
+		reg = <0x36>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		interrupt-parent = <&nmi_intc>;
+		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+		status = okay;
+
+		vin1-supply = <&reg_vcc5v>;
+		vin2-supply = <&reg_vcc5v>;
+		vin3-supply = <&reg_vcc5v>;
+
+		regulators {
+			reg_dcdc1: dcdc1 {
+				regulator-always-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <1160000>;
+				regulator-name = vdd-cpul;
+			};
+
+			reg_swout1: swou1 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = vdd-swout1;
+			};
+
+			reg_swout2: swout2 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = vdd-swout2;
+			};
+
+			aldo1 {
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = vcc-mipi-dsi;
+			};
+
+			reg_dcdc2_323: dcdc2 {
+				regulator-always-on;
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <800000>;
+				regulator-name = vdd-sys;
+			};
+
+			reg_dcdc3_323: dcdc3 {
+				regulator-always-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <1000000>;
+				regulator-name = vdd-cpub;
+			};
+
+			reg_dcdc5_323: dcdc5 {
+				regulator-always-on;
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <1000000>;
+				regulator-name = vdd-cpul;
+			};
+
+			reg_cldo1: cldo1 {
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = vcc-pm;
+			};
+
+			reg_cldo2: cldo2 {
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = vcc-hdmi;
+			};
+
+			reg_cldo3: cldo3 {
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = vcc-dram;
+			};
+
+			reg_cldo4: cldo4 {
+			};
+
+			reg_cldo5: cldo5 {
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = vcc-pc;
+			};
+		};
+	};
+};
diff --git a/configs/orangepi-4-pro_defconfig b/configs/orangepi-4-pro_defconfig
new file mode 100644
index 00000000..dac13eaf
--- /dev/null
+++ b/configs/orangepi-4-pro_defconfig
@@ -0,0 +1,22 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
+CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x4F000000
+CONFIG_DEFAULT_DEVICE_TREE=sun60i-a733-orangepi-4-pro
+CONFIG_SPL=y
+CONFIG_MACH_SUN60I_A733=y
+CONFIG_MMC_SUNXI_SLOT_EXTRA=2
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_SPL_LOAD_FIT_ADDRESS=0x4D000000
+CONFIG_BOOTDELAY=3
+CONFIG_SPL_RAM_DEVICE=y
+CONFIG_CMD_DFU=y
+CONFIG_CMD_I2C=y
+CONFIG_NET_RANDOM_ETHADDR=y
+CONFIG_SYS_I2C_MVTWSI=y
+CONFIG_SUPPORT_EMMC_BOOT=y
+CONFIG_REGULATOR_AXP=y
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_MUSB_GADGET=y
+CONFIG_USB_ETH_CDC=y
-- 
2.55.0
